{
  "manifest_version": 3,
  "name": "Google Voice Sheet Dialer",
  "version": "1.3.2",
  "description": "Click phone numbers in Google Sheets and dial them through Google Voice.",
  "permissions": [
    "contextMenus",
    "debugger",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://docs.google.com/spreadsheets/*",
    "https://voice.google.com/*"
  ],
  "action": {
    "default_title": "Voice Dialer",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": [
        "sheets-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://voice.google.com/*"
      ],
      "js": [
        "voice-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://docs.google.com/spreadsheets/*",
        "https://voice.google.com/*"
      ],
      "js": [
        "web-click-to-dial.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
